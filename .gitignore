## LaTeX
# Core latex/pdflatex auxiliary files:
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.fmt
*.fot
*.cb
*.cb2
.*.lb

# Intermediate documents:
*.dvi
*.xdv
*-converted-to.*

# Bibliography auxiliary files (bibtex/biblatex/biber):
*.bbl
*.bcf
*.blg
*-blx.aux
*-blx.bib
*.run.xml

# Build tool auxiliary files:
*.fdb_latexmk
*.synctex
*.synctex(busy)
*.synctex.gz
*.synctex.gz(busy)
*.pdfsync

# Auxiliary and intermediate files from other packages:
# algorithms
*.alg
*.loa

# amsthm
*.thm

# beamer
*.nav
*.pre
*.snm
*.vrb

# glossaries
*.acn
*.acr
*.glg
*.glo
*.gls
*.glsdefs
*.lzo
*.lzs
*.slg
*.slo
*.sls

# nomencl
*.nlo

# endnotes
*.ent

# minted/pygments
*.pytxcode
_minted*

## OS files
.DS_Store
Thumbs.db

## IDEs
.vscode/
.idea/
*.swp
*.swo

## Python (since there are scripts in the repo)
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/

